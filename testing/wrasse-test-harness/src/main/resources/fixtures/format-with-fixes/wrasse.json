{
    "format": { "enabled": true },
    "rules": {
        "no-semicolons": { "level": "error" },
        "no-unused-imports": { "level": "error" },
        "no-wildcard-imports": { "level": "error" },
        "if-else-bracing": { "level": "error", "allow-inline": true },
        "unnecessary-backticks": { "level": "error" },
        "explicit-it-lambda-parameter": { "level": "error" },
        "empty-default-constructor": { "level": "error" },
        "redundant-constructor-keyword": { "level": "error" },
        "trivial-accessors": { "level": "error" },
        "long-numerical-values": { "level": "error" },
        "range-conventional": { "level": "error" }
    }
}
