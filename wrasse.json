{
    "$schema": "./wrasse-schema.json",
    "rules": {
        "modifier-order": { "level": "error" },
        "no-empty-class-body": { "level": "error" },
        "import-ordering": { "level": "error" },
        "no-unnecessary-fqn": { "level": "error" },
        "no-unit-return": { "level": "error" },
        "no-empty-parens-before-trailing-lambda": { "level": "error" },
        "no-semicolons": { "level": "error" },
        "no-unused-imports": { "level": "error" },
        "no-wildcard-imports": { "level": "error" },
        "trailing-newline": { "level": "error" }
    }
}
