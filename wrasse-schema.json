{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Wrasse Configuration",
    "description": "Configuration file for the Wrasse Kotlin compiler plugin",
    "type": "object",
    "required": [
        "exclude",
        "rules"
    ],
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string"
        },
        "exclude": {
            "type": "array",
            "description": "Glob patterns for files to exclude from all rules",
            "items": {
                "type": "string"
            }
        },
        "rules": {
            "type": "object",
            "description": "Rule configurations",
            "additionalProperties": false,
            "properties": {
                "no-semicolons": {
                    "$ref": "#/$defs/ruleConfig",
                    "description": "Disallow unnecessary semicolons"
                },
                "no-wildcard-imports": {
                    "$ref": "#/$defs/ruleConfig",
                    "description": "Disallow wildcard imports"
                },
                "trailing-newline": {
                    "$ref": "#/$defs/ruleConfig",
                    "description": "Require a trailing newline at end of file"
                }
            }
        }
    },
    "$defs": {
        "ruleConfig": {
            "type": "object",
            "required": [
                "level",
                "exclude"
            ],
            "additionalProperties": false,
            "properties": {
                "level": {
                    "type": "string",
                    "enum": [
                        "off",
                        "warn",
                        "error"
                    ],
                    "description": "Rule severity: 'off' disables, 'warn' reports as warning, 'error' reports as error"
                },
                "exclude": {
                    "type": "array",
                    "description": "Additional glob patterns to exclude for this rule",
                    "items": {
                        "type": "string"
                    }
                }
            }
        }
    }
}
